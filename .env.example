# Copy to .env and fill in. .env is gitignored — never commit real values.
# See docs/configuration.md for the full reference.

# "org" or "repo".
RUNNERDECK_SCOPE=org

# Only used when RUNNERDECK_SCOPE=org.
RUNNERDECK_ORG=your-org-name

# "owner/repo". Only used when RUNNERDECK_SCOPE=repo.
# RUNNERDECK_REPO=your-username/your-repo

# Shared label across the runner pool.
RUNNERDECK_LABEL=self-hosted-runnerdeck

# Extra labels on add/rename (comma-separated). Existing runners keep
# their current labels until you rename them.
# RUNNERDECK_EXTRA_LABELS=linux,gpu

# Where runner-base/runner-1/.../runner-N live. Defaults to a `runners/`
# directory next to this repo checkout.
# RUNNERDECK_POOL_DIR=/absolute/path/to/runners

# Explicit path to `gh`, if it's not resolvable from PATH.
# RUNNERDECK_GH_BIN=/absolute/path/to/gh

# Explicit `gh` config directory, if different from the default.
# GH_CONFIG_DIR=/absolute/path/to/gh/config/dir

# Optional GitHub App instead of `gh auth login`. PEM is a file, not this env.
# RUNNERDECK_GITHUB_APP_ID=123456
# RUNNERDECK_GITHUB_APP_INSTALLATION_ID=12345678
# RUNNERDECK_GITHUB_APP_KEY_FILE=/absolute/path/to/app.pem

# Check this project's own GitHub Releases for a newer version.
# RUNNERDECK_CHECK_UPDATES=1

# TOTP secret for the optional login gate. Set via `php bin/setup-totp.php`,
# not by hand.
# RUNNERDECK_AUTH_TOTP_SECRET=

# Minutes of no requests before a TOTP session expires (1–1440). Off if unset.
# RUNNERDECK_SESSION_IDLE_MINUTES=30

# Auto-restart a runner that crashed unexpectedly.
# RUNNERDECK_AUTO_RESTART=1

# Start stopped slots when jobs are waiting on this pool's label.
# RUNNERDECK_SCALE_TO_QUEUE=1

# Max locally running slots (1–30). Unset = no cap besides the 30-slot pool.
# RUNNERDECK_POOL_CAP=8

# Stop a GitHub-idle slot after this many minutes (1–1440). Off if unset.
# Skips busy and Pause-AR slots. Off while jobs are queued for this label.
# RUNNERDECK_IDLE_STOP_MINUTES=15

# Delete _work after idle-stop or drain-stop. Regular Stop leaves the tree.
# RUNNERDECK_AUTO_CLEAR_WORK=1

# Fire the crash webhook once when a job on this label has waited this
# many minutes (1–1440). Off if unset.
# RUNNERDECK_QUEUE_WAIT_MINUTES=15

# Fire the crash webhook once when an in-progress job on this host has
# run this many minutes (1–1440). Off if unset.
# RUNNERDECK_LONG_JOB_MINUTES=60

# Refuse new starts when the pool filesystem has less than this many GiB
# free (default 1). 0 = off.
# RUNNERDECK_MIN_FREE_DISK_GIB=1

# Refuse new starts when Linux MemAvailable is below this many MiB
# (default 256). 0 = off. Ignored when RAM cannot be read.
# RUNNERDECK_MIN_FREE_RAM_MIB=256

# POST a notification when a crash-loop is flagged. Slack/Discord webhook
# URLs get their native payload shape; anything else gets plain JSON.
# RUNNERDECK_CRASH_WEBHOOK_URL=https://hooks.slack.com/services/...

# Also POST when a runner first reaches this many crashes in 7 days.
# RUNNERDECK_CRASH_WEBHOOK_THRESHOLD=5

# Seconds to wait for GitHub busy=false on drain-stop (1–3600, default 600).
# Also settable from Settings.
# RUNNERDECK_DRAIN_TIMEOUT=600

# Also POST when a slot or the pool first reaches this many GiB of disk.
# RUNNERDECK_DISK_WEBHOOK_THRESHOLD=10

# Honor X-Forwarded-Proto when the reverse proxy is not on loopback
# (see docs/hosting.md). Same-machine Caddy/nginx → 127.0.0.1:8090 does
# not need this.
# RUNNERDECK_TRUST_PROXY=1
