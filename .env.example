# Copy to .env and fill in. .env is gitignored — never commit real values.

# Whether runners are managed at the org level or scoped to a single repo
# you own. GitHub's API has no such thing as a personal-account-level
# runner — "org" needs RUNNERDECK_ORG below and org-admin access; "repo"
# needs RUNNERDECK_REPO below and repo-admin access (you have this
# automatically on repos you own), using the `repo` OAuth scope that
# `gh auth login`'s default scopes already include.
RUNNERDECK_SCOPE=org

# Your GitHub org. Only used when RUNNERDECK_SCOPE=org.
RUNNERDECK_ORG=your-org-name

# "owner/repo" to scope runners to a single repository instead of an org.
# Only used when RUNNERDECK_SCOPE=repo.
# RUNNERDECK_REPO=your-username/your-repo

# Shared label used across your whole runner pool. Also doubles as the
# runner-base instance's own registered name (see README).
RUNNERDECK_LABEL=self-hosted-runnerdeck

# Uncomment to override where runner-base/runner-1/.../runner-N live.
# Defaults to a `runners/` directory next to this repo checkout.
# RUNNERDECK_POOL_DIR=/absolute/path/to/runners

# Uncomment if `gh` isn't resolvable from PATH in whatever context launches
# run.sh (e.g. a minimal systemd unit).
# RUNNERDECK_GH_BIN=/absolute/path/to/gh

# Uncomment if `gh auth login` was run in an environment with a different
# config directory than this one sees (e.g. a sandboxed terminal).
# GH_CONFIG_DIR=/absolute/path/to/gh/config/dir

# Uncomment to check this project's own GitHub Releases for a newer
# version and show a badge in the header. Off by default — it's the only
# thing here that calls out to a repo other than the one you're managing
# runners for. Also toggleable from the in-app Settings dialog.
# RUNNERDECK_CHECK_UPDATES=1

# Set (via `php bin/setup-totp.php`, not by hand) to require an
# authenticator app code before the dashboard or API respond to anything.
# Off by default — RunnerDeck assumes localhost-only access unless you opt
# in here AND put a TLS-terminating reverse proxy in front (see README's
# "Hosting remotely" section). Not settable from the in-app Settings
# dialog by design.
# RUNNERDECK_AUTH_TOTP_SECRET=

# Uncomment to automatically restart a runner that crashed unexpectedly
# (up to 3 attempts before giving up and flagging it with a toast/row
# badge instead). Off by default. Also toggleable from the in-app
# Settings dialog.
# RUNNERDECK_AUTO_RESTART=1
