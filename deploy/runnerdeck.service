# Optional: process supervision for ./run.sh (php -S, Linux systemd user
# unit). Not required — `./run.sh` works by hand. For a TLS hostname use
# php-fpm + watch instead: deploy/runnerdeck-php-fpm.service and
# deploy/runnerdeck-watch.service (docs/hosting.md).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/runnerdeck.service ~/.config/systemd/user/
#   # edit WorkingDirectory below to your checkout path
#   systemctl --user daemon-reload
#   systemctl --user enable --now runnerdeck
#   loginctl enable-linger "$USER"   # keep it running after logout

[Unit]
Description=RunnerDeck (self-hosted GitHub Actions runner pool UI)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Github-Actions-SelfHost
ExecStart=%h/Github-Actions-SelfHost/run.sh 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
