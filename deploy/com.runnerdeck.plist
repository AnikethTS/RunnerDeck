<!-- Optional: process supervision for ./run.sh (php -S, macOS launchd
     user agent). Not required. TLS hostname: php-fpm, see docs/hosting.md.

     Install:
       cp deploy/com.runnerdeck.plist ~/Library/LaunchAgents/
       # edit the two /absolute/path/to placeholders below
       launchctl load ~/Library/LaunchAgents/com.runnerdeck.plist
-->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.runnerdeck</string>
    <key>ProgramArguments</key>
    <array>
        <string>/absolute/path/to/Github-Actions-SelfHost/run.sh</string>
        <string>8090</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/absolute/path/to/Github-Actions-SelfHost</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/runnerdeck.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/runnerdeck.err.log</string>
</dict>
</plist>
