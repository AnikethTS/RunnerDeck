# Internet-facing nginx + php-fpm. TOTP on 443 is not enough: anyone who
# can reach login can try codes, and a VPS root shell still has `gh` plus
# the runner pool. Pick at least one of: Tailscale (no public 443), IP
# allowlist, client certificates (mTLS). See docs/hosting.md.
#
# Replace root, server_name, allowlist, and certificate paths, then:
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name runnerdeck.example.com;

    # ssl_certificate     /etc/letsencrypt/live/runnerdeck.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/runnerdeck.example.com/privkey.pem;

    # --- IP allowlist (uncomment and replace) ---
    # allow 203.0.113.10;
    # allow 2001:db8::/32;
    # deny all;

    # --- mTLS: require a client cert you issued (uncomment) ---
    # ssl_client_certificate /etc/nginx/runnerdeck-clients.pem;
    # ssl_verify_client on;

    root /home/YOU/Github-Actions-SelfHost/public;
    index index.php;

    location = /health.php {
        access_log off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
        fastcgi_param HTTPS on;
        fastcgi_pass 127.0.0.1:9000;
    }

    location = /log_stream.php {
        gzip off;
        fastcgi_buffering off;
        fastcgi_read_timeout 2100s;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
        fastcgi_param HTTPS on;
        fastcgi_pass 127.0.0.1:9000;
    }

    location ~ \.php$ {
        fastcgi_read_timeout 120s;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
        fastcgi_param HTTPS on;
        fastcgi_pass 127.0.0.1:9000;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name runnerdeck.example.com;
    return 301 https://$host$request_uri;
}
