<?xml version="1.0"?>
<ruleset name="RunnerDeck">
    <description>Coding standard for RunnerDeck</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="p"/>
    <arg name="extensions" value="php"/>
    <file>src</file>
    <file>public</file>
    <file>tests</file>
    <file>bin</file>
    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Front-controller scripts mix declarations with side effects by design.
         App classes live in the RunnerDeck namespace (PSR-4 via bootstrap.php). -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <severity>0</severity>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <severity>0</severity>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <severity>0</severity>
    </rule>
</ruleset>
