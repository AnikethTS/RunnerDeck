{
  "name": "runnerdeck-dev-tooling",
  "private": true,
  "description": "Dev-only tooling for RunnerDeck (lint, E2E tests) — never a runtime dependency of the app itself.",
  "type": "module",
  "scripts": {
    "lint:js": "eslint public/assets/app.js public/assets/js",
    "lint:css": "stylelint public/assets/style.css",
    "audit": "node scripts/npm-audit.mjs",
    "e2e": "playwright test",
    "e2e:update-shots": "playwright test --update-snapshots --grep \"first-run setup|README\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "minimatch": "11.0.1"
  }
}
