{
  "name": "runnerdeck-dev-tooling",
  "private": true,
  "description": "Dev-only tooling for RunnerDeck (lint, E2E tests) — never a runtime dependency of the app itself.",
  "type": "module",
  "scripts": {
    "lint:js": "eslint app/public/assets/app.js app/public/assets/js",
    "lint:css": "stylelint app/public/assets/style.css",
    "audit": "node tools/ci/npm-audit.mjs",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c tests/e2e-live/playwright.config.js",
    "e2e:update-shots": "playwright test --update-snapshots --grep \"first-run setup|README\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "minimatch": "11.0.1"
  }
}
